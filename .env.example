# Which rental-data provider to use.
#   "mock"     -> deterministic simulated data (default, no API key needed)
#   "rentcast" -> live data from RentCast (https://www.rentcast.io/api), requires a key
DATA_PROVIDER=mock

# Required only when DATA_PROVIDER=rentcast
# Sign up at https://app.rentcast.io to get a key.
RENTCAST_API_KEY=
